# ---- Secrets and per-machine configuration -------------------------------
.env
# the copies envfile.py keeps before every change, and any other .env of your own (.env.example stays in git)
.env.bak-*
.env.local
# what the setup wizard remembers, and your own shortcuts, contacts and backups
DataBase/setup_state.json
DataBase/shortcuts.json
DataBase/contacts.json
Backups/

# ---- Environments, caches, build output ----------------------------------
.venv/
__pycache__/
*.pyc
.claude/
dist/
build/
*.egg-info/

# ---- Personal data: never commit -----------------------------------------
Logs/
DataBase/Passwords/
DataBase/API Keys/
DataBase/Notes/
DataBase/NotePad/
DataBase/Tasks/
DataBase/ScreenShot/
DataBase/Downloads/
DataBase/Books/
DataBase/Cache/
DataBase/memory.json
DataBase/TimeTable/timetable.json
# Face samples + the trained model are biometric data
DataBase/FaceDetectionModule/samples/
DataBase/FaceDetectionModule/trainer/

# ---- Models trained on this PC, and what they were measured on (your own sentences are in these)
models/
# Your voice print (biometric: it never leaves this PC; python enroll_voice.py --delete removes it)
DataBase/voiceprint.npz
training/nlu_real.txt
training/reports/

# ---- Large personal media (moved out of the project during the rebuild) ---
DataBase/Videos/
DataBase/PDF Books/
DataBase/Music/
DataBase/Photos/
DataBase/GooglePhotos/
DataBase/9th DMC/
DataBase/Study Material/
DataBase/NasaDataBase/
