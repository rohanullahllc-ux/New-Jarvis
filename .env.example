# Copy this file to ".env" and change what you need. Every setting is optional:
# a feature whose key is missing simply tells you so instead of crashing.
# (Put comments on their own line - not after a value.)

# ---- About you ---------------------------------------------------------
# How Jarvis addresses you
USER_NAME=Mr Khan
# City used for weather when you don't name one
DEFAULT_CITY=Peshawar
# "dollar rate" converts into this currency
HOME_CURRENCY=PKR

# ---- Unlock password (Startup.py and the GUI) --------------------------
# Plain text works, but a hash is safer: run  python gate.py --set-password
# and it writes JARVIS_PASSWORD_HASH for you (and clears the plain one).
JARVIS_PASSWORD=
JARVIS_PASSWORD_HASH=
# true = glance at the webcam after the password for extra confirmation (it never blocks entry)
FACE_CHECK=true

# ---- Voice ---------------------------------------------------------------
# voice = talk to Jarvis, text = type commands instead
INPUT_MODE=voice
# auto tries sounddevice first and falls back to winmm; or force one of them
MIC_BACKEND=auto
# Seconds of silence that end what you are saying. Raise it if Jarvis cuts you off while you think (1.3 is the default)
MIC_PAUSE=1.3
# The language Google's speech recognition expects: en-pk (Pakistani English), en-in, en-us, en-gb... If a different one hears you
# better, use that. SPEECH_LANGUAGE_FALLBACK is tried once when the first one understood nothing.
SPEECH_LANGUAGE=en-pk
SPEECH_LANGUAGE_FALLBACK=en-us
# true = a short beep when the microphone has just been opened, meaning "speak now"
MIC_BEEP=true
# A microphone that is muted, or turned down under 50 percent in Windows, is the commonest reason Jarvis misses words. When he
# finds it like that at start-up he sets it to this many percent (he never turns a louder one down). 0 = never touch Windows' setting.
MIC_VOLUME=80
# Blank = the Windows default microphone. Otherwise part of its name (e.g. Realtek,
# Headset) or its number - see: python microphone.py --list
MIC_DEVICE=
# false = answers appear as text only (much faster, no speech)
TTS_ENABLED=true
# Part of a Windows voice name (e.g. Zira, David); blank = the Windows default voice
TTS_VOICE=
# Louder or quieter, 0 to 100
TTS_VOLUME=100
# Slower or faster speech, -10 to 10 (0 = normal). Run  python speech.py  to hear the result
TTS_RATE=0
# short = one greeting line, full = also weather, time table, to-do list and a low-battery warning, silent = none
STARTUP_GREETING=short
# The window's moving pictures; set to false for still ones on a slow PC
GUI_ANIMATIONS=true

# ---- Chat: a free AI model on this PC (Ollama) answers anything the built-in commands don't cover ----------------
# Where Ollama listens. Leave it out unless Ollama runs on another computer. ("localhost" is rewritten to 127.0.0.1: on many
# Windows PCs a connection to "localhost" waits two seconds for IPv6 to fail first, on every request.)
# OLLAMA_URL=http://127.0.0.1:11434
# Install Ollama (ollama.com), then:  ollama pull llama3.2:3b   (and/or  ollama pull qwen2.5:1.5b  for a faster one)
# auto = Ollama if it is running, with a free key (below) as the backup; ollama = only Ollama; cloud = only the key
CHAT_ENGINE=auto
# auto = the biggest installed model that fits in the free RAM, up to CHAT_AUTO_MAX_MB; or name one, e.g. llama3.2:3b
OLLAMA_MODEL=auto
# "auto" never picks a model bigger than this many MB (a 3B model starts speaking 6-10 s after you ask on a CPU, a 1.5B one 3-5 s)
CHAT_AUTO_MAX_MB=1600
# How long the model stays in RAM after your last question (10m = ten minutes, 0 = unload at once)
OLLAMA_KEEP_ALIVE=10m
# The most question-and-answer pairs Jarvis keeps in mind in one conversation. When it is reached the oldest half is
# forgotten at once (rather than one pair at a time), which keeps answers quick: Ollama can reuse what it already read.
CHAT_MEMORY_TURNS=8
# true = look facts up (Wikipedia; DuckDuckGo for news) before answering. The words of the question are sent there.
CHAT_WEB_SEARCH=true
# true = load the model when Jarvis starts (answers sooner, but uses 1-2 GB of RAM at once)
CHAT_PRELOAD=false
# true = Jarvis's own trained language model (made by: python training/train_nlu.py) helps understand loosely worded commands.
# It is only used when models/nlu.joblib exists, and never for shutting down without asking. false = patterns only.
LANGUAGE_MODEL=true

# ---- A private record of what is said to Jarvis and what he answers (Logs/conversations/, one file a day) -----------
# Read it with:  python transcript.py     (--days 3, --you, --delete). It never leaves this PC.
# false = record nothing
LOG_CONVERSATIONS=true
# Records older than this many days are deleted at the start of a session (0 = keep for ever)
CONVERSATION_LOG_DAYS=30

# ---- Optional: a free online AI key, the faster alternative (or backup) to the model on this PC --------------------
# Make a free key (no card) at console.groq.com or aistudio.google.com and paste it here.
# Jarvis works out which service it belongs to. Your questions then go to that service.
LLM_API_KEY=
# auto (default), groq, gemini, openrouter, ollama or custom. Normally leave as auto.
LLM_PROVIDER=auto
# Blank = a good free model for that service
LLM_MODEL=

# ---- AI brain (optional) -------------------------------------------------
# With a key Jarvis understands natural speech and uses Claude; without one it uses
# its built-in free command understanding. https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the most capable; claude-sonnet-5-5 and claude-haiku-5-5 are cheaper
CLAUDE_MODEL=claude-opus-5-5
# low = quickest replies; medium or high think more before answering
CLAUDE_EFFORT=low

# ---- Third-party services (all optional) --------------------------------
# Wolfram Alpha "ask a question" feature - https://developer.wolframalpha.com
WOLFRAM_APP_ID=
# NASA features - https://api.nasa.gov (DEMO_KEY works but is rate limited)
NASA_API_KEY=DEMO_KEY
# Sending email - use an *app password* (Gmail, Yahoo and iCloud all offer them), never your real password
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Mail server; leave blank and Jarvis works it out from the address (Gmail, Yahoo, Outlook, iCloud)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
