# Copy this file to ".env" and change what you need. Every setting is optional:
# a feature whose key is missing simply tells you so instead of crashing.
# (Put comments on their own line - not after a value.)

# ---- About you ---------------------------------------------------------
# How Jarvis addresses you
USER_NAME=Mr Khan
# City used for weather when you don't name one
DEFAULT_CITY=Peshawar
# "dollar rate" converts into this currency
HOME_CURRENCY=PKR

# ---- Unlock password (Startup.py and the GUI) --------------------------
# Plain text works, but a hash is safer: run  python gate.py --set-password
# and it writes JARVIS_PASSWORD_HASH for you (and clears the plain one).
JARVIS_PASSWORD=
JARVIS_PASSWORD_HASH=
# true = glance at the webcam after the password for extra confirmation (it never blocks entry)
FACE_CHECK=true

# ---- Voice ---------------------------------------------------------------
# voice = talk to Jarvis, text = type commands instead
INPUT_MODE=voice
# auto tries sounddevice first and falls back to winmm; or force one of them
MIC_BACKEND=auto
# Blank = the Windows default microphone. Otherwise part of its name (e.g. Realtek,
# Headset) or its number - see: python microphone.py --list
MIC_DEVICE=
# false = answers appear as text only (much faster, no speech)
TTS_ENABLED=true
# Part of a Windows voice name (e.g. Zira, David); blank = the first installed voice
TTS_VOICE=
# short = one greeting line, full = also weather, time table, to-do list and a low-battery warning, silent = none
STARTUP_GREETING=short
# The window's moving pictures; set to false for still ones on a slow PC
GUI_ANIMATIONS=true

# ---- AI brain (optional) -------------------------------------------------
# With a key Jarvis understands natural speech and uses Claude; without one it uses
# its built-in free command understanding. https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the most capable; claude-sonnet-5-5 and claude-haiku-5-5 are cheaper
CLAUDE_MODEL=claude-opus-5-5
# low = quickest replies; medium or high think more before answering
CLAUDE_EFFORT=low

# ---- Third-party services (all optional) --------------------------------
# Wolfram Alpha "ask a question" feature - https://developer.wolframalpha.com
WOLFRAM_APP_ID=
# NASA features - https://api.nasa.gov (DEMO_KEY works but is rate limited)
NASA_API_KEY=DEMO_KEY
# Sending email - use an *app password* (Gmail, Yahoo and iCloud all offer them), never your real password
EMAIL_ADDRESS=
EMAIL_PASSWORD=
# Mail server; leave blank and Jarvis works it out from the address (Gmail, Yahoo, Outlook, iCloud)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
