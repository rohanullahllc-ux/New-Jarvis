# Copy this file to ".env" and change what you need. Every setting is optional:
# a feature whose key is missing simply tells you so instead of crashing.
# (Put comments on their own line - not after a value.)
#
# This file is written by  python settings_registry.py --write-example  from settings_registry.py: change a setting there, not here.
# The easy way to change settings is the admin panel in the Jarvis window, or the setup wizard (Setup-Jarvis.bat).

# ---- About you ---------------------------------------------------------------
# Who you are and where you are, so that greetings, weather and money fit you.
# How Jarvis greets you, for example "Good morning Mr Khan".
USER_NAME=Mr Khan
# The short word Jarvis puts in his replies, such as "Ok sir". Whatever you choose replaces "sir" everywhere.
ADDRESS_AS=sir
# Used for the weather and for "where am I" when you do not name a city.
DEFAULT_CITY=Peshawar
# "Dollar rate" and "100 dollars in rupees" convert into this currency. Use its three-letter code.
HOME_CURRENCY=PKR

# ---- How Jarvis speaks -------------------------------------------------------
# His voice, its volume and speed, and what he says when he starts.
# Off means Jarvis answers in text only, which is much faster. The replies still appear in the window.
TTS_ENABLED=true
# Automatic uses the natural voice (Piper, made on this PC) when one is installed and the Windows voice otherwise.
# Choices: auto, piper, windows
TTS_ENGINE=auto
# Which natural voice speaks. python tts_piper.py --demo plays every installed voice, and the setup wizard can add more.
PIPER_VOICE=en_GB-alan-medium
# Only used when the natural voice is not. Part of a Windows voice name, for example Zira or David. Blank = the Windows
# default.
TTS_VOICE=
# How loud Jarvis speaks, 0 to 100.
TTS_VOLUME=100
# -10 is slower, 10 is faster, 0 is normal. Run python speech.py to hear the result.
TTS_RATE=0
# One short greeting, or the full report (weather, today's time table, your to-do list and a low-battery warning), or
# nothing.
# Choices: short, full, silent
STARTUP_GREETING=short

# ---- How Jarvis hears you ----------------------------------------------------
# The microphone, the speech recognition, and how long a pause ends your sentence.
# Voice means you talk to Jarvis. Text means you type your commands instead and the microphone is never touched.
# Choices: voice, text
INPUT_MODE=voice
# Automatic uses Whisper on this PC and asks Google only when Whisper heard nothing. Whisper never uses the internet.
# Google is the old way and needs the internet.
# Choices: auto, whisper, google
STT_ENGINE=auto
# tiny.en is the quickest, base.en is the balance, small.en is the most accurate and the slowest. A bigger one needs a
# stronger PC.
# Choices: tiny.en, base.en, small.en
STT_MODEL=base.en
# The accent Google's speech recognition expects: en-pk is Pakistani English. If a different one hears you better, use
# that.
SPEECH_LANGUAGE=en-pk
# Tried once when the first accent understood nothing.
SPEECH_LANGUAGE_FALLBACK=en-us
# Blank = the Windows default microphone. Otherwise part of its name (for example Realtek or Headset) or its number:
# python microphone.py --list shows them.
MIC_DEVICE=
# Automatic tries sounddevice first and falls back to Windows' own winmm. Force one only if the other misbehaves.
# Choices: auto, sounddevice, winmm
MIC_BACKEND=auto
# Seconds of silence that end what you are saying. Raise it if Jarvis cuts you off while you think; lower it for quicker
# answers.
MIC_PAUSE=1.3
# A short beep when the microphone has just been opened. It means "speak now".
MIC_BEEP=true
# A microphone that is muted, or turned down under 50 percent in Windows, is the commonest reason Jarvis misses words.
# When he finds it like that at start-up he sets it to this many percent (he never turns a louder one down). 0 = never
# touch Windows' setting.
MIC_VOLUME=80

# ---- Waking and security -----------------------------------------------------
# How he is woken, whose voice he answers, and the password in front of everything.
# While the window is open and he is asleep, saying "hey Jarvis" wakes him (he then asks for the password as usual). It
# is recognised on this PC; no sound is sent anywhere.
WAKE_WORD=true
# Higher hears "hey Jarvis" more easily but wakes by mistake more often. Lower it if he wakes when nobody called him.
WAKE_SENSITIVITY=0.5
# Clapping wakes him (he then asks for the password as usual).
CLAP_WAKE=true
# How many claps in a row wake him.
CLAP_COUNT=2
# Higher counts softer claps. Raise it if your claps are missed, lower it if typing or talking wakes him.
CLAP_SENSITIVITY=1.0
# Automatic switches it on once you have taught him your voice (python enroll_voice.py). Always means he answers only
# you. Off means he answers any voice. The typed box and the buttons always work.
# Choices: auto, owner, off
VOICE_LOCK=auto
# How alike a voice must be to yours to be accepted (0.2 to 0.9). 0 = the level chosen when you taught him your voice.
VOICE_MATCH=0
# After the password Jarvis glances at the webcam for extra confirmation. It never blocks you: the password is what lets
# you in.
FACE_CHECK=true
# The unlock password written as plain text. It works, but anyone who can read the .env file can read it. Use the
# "Change password" button instead, which stores only a scrambled form.
JARVIS_PASSWORD=
# The unlock password stored as a salted hash. Made for you by the setup wizard, the admin panel or python gate.py
# --set-password.
JARVIS_PASSWORD_HASH=

# ---- Thinking and chatting ---------------------------------------------------
# The AI model that answers questions the built-in commands do not cover.
# Automatic uses Ollama (the AI model on this PC) when it is running, with a free online key as the backup. Ollama means
# only the model on this PC. Cloud means only the online key.
# Choices: auto, ollama, cloud
CHAT_ENGINE=auto
# Automatic picks the biggest installed model that fits in the free memory, up to the size limit below. Or name one, for
# example qwen2.5:1.5b (quicker) or llama3.2:3b (writes a little better).
OLLAMA_MODEL=auto
# "Automatic" never picks a model bigger than this many MB: a 3B model starts speaking 6 to 10 seconds after you ask on
# a CPU, a 1.5B one 3 to 5 seconds.
CHAT_AUTO_MAX_MB=1600
# How long the model stays in memory after your last question: 10m is ten minutes, 0 unloads it at once.
OLLAMA_KEEP_ALIVE=10m
# The most question-and-answer pairs kept in mind in one conversation. When the limit is reached the oldest half is
# forgotten at once, which keeps answers quick.
CHAT_MEMORY_TURNS=8
# Answers sooner, but uses 1 to 2 GB of memory from the start. Leave it off on a PC with 8 GB or less.
CHAT_PRELOAD=false
# Jarvis's own model (made by python training/train_nlu.py) helps him understand loosely worded commands. It is only
# used when models/nlu.joblib exists, and never to shut down without asking.
LANGUAGE_MODEL=true
# Leave it out unless Ollama runs on another computer. ("localhost" is rewritten to 127.0.0.1 because on many Windows
# PCs "localhost" waits two seconds for IPv6 to fail first, on every request.)
# OLLAMA_URL=http://127.0.0.1:11434
# Optional. A free key (no card) from console.groq.com or aistudio.google.com. Jarvis works out which service it belongs
# to. It is the faster alternative to the model on this PC, or its backup.
LLM_API_KEY=
# Normally leave this on automatic.
# Choices: auto, groq, gemini, openrouter, ollama, custom
LLM_PROVIDER=auto
# Blank = a good free model for that service.
LLM_MODEL=
# Only for the "custom" service: any OpenAI-compatible address.
# LLM_BASE_URL=
# Optional. With a key Jarvis understands natural speech and uses Claude; without one he uses his built-in free command
# understanding. https://console.anthropic.com
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the most capable; claude-sonnet-5-5 and claude-haiku-5-5 are cheaper.
CLAUDE_MODEL=claude-opus-5-5
# Low gives the quickest replies; medium or high think more before answering.
# Choices: low, medium, high
CLAUDE_EFFORT=low

# ---- Accounts and online services --------------------------------------------
# Email and the optional online services. Every one of them is optional.
# For sending email by voice. Gmail, Yahoo, Outlook and iCloud work.
EMAIL_ADDRESS=
# Use an app password (Gmail, Yahoo and iCloud all offer them), never your real password.
EMAIL_PASSWORD=
# Leave blank and Jarvis works it out from the address (Gmail, Yahoo, Outlook, iCloud).
EMAIL_SMTP_HOST=
# Almost always 587.
EMAIL_SMTP_PORT=587
# Optional, for "ask Wolfram ..." questions. https://developer.wolframalpha.com
WOLFRAM_APP_ID=
# A free personal key from api.nasa.gov removes the shared DEMO_KEY's hourly limit.
NASA_API_KEY=DEMO_KEY

# ---- Privacy and records -----------------------------------------------------
# What is written down, for how long, and what is sent out of this PC.
# Before the chat model answers a factual question, Jarvis looks it up (Wikipedia; DuckDuckGo for news) so that a small
# model does not invent facts. The words of the question are sent there. Off keeps every question on this PC.
CHAT_WEB_SEARCH=true
# A private record of what you said and what Jarvis answered, one file a day in Logs/conversations. It never leaves this
# PC. Read it with python transcript.py. Off records nothing.
LOG_CONVERSATIONS=true
# Records older than this many days are deleted when a session starts. 0 = keep for ever.
CONVERSATION_LOG_DAYS=30

# ---- The window --------------------------------------------------------------
# How the window looks and behaves.
# Off shows still pictures, which is lighter on a slow PC.
GUI_ANIMATIONS=true
