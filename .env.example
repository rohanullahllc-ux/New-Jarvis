# Copy this file to ".env" and fill in your own keys. All are optional:
# features whose key is missing simply tell you so instead of crashing.

# "voice" to talk to Jarvis, "text" to type commands instead
INPUT_MODE=voice

# AI brain (https://console.anthropic.com). With a key, Jarvis understands
# natural speech and uses its tools; without one it uses the old keyword commands.
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the most capable; claude-sonnet-5-5 and claude-haiku-5-5
# are cheaper and faster.
CLAUDE_MODEL=claude-opus-5-5
# low = quickest replies; medium or high think more before answering
CLAUDE_EFFORT=low

# Wolfram Alpha "question" feature (https://developer.wolframalpha.com)
WOLFRAM_APP_ID=

# Your city, used for weather when you don't name one (weather needs no key)
DEFAULT_CITY=Peshawar

# NASA features (https://api.nasa.gov) - DEMO_KEY works but is rate limited
NASA_API_KEY=DEMO_KEY

# Email sending (use a Gmail *app password*, never your real password)
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# RapidAPI (business names, free games, corona stats in keyword mode)
RAPIDAPI_KEY=
